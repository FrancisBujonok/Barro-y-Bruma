  m_Script: {fileID: 11500000, guid: b4d841760c601c54db73ff20c653bca7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BrumaPx.Dialogue.TalkableNpc
  displayName: "Vig\xEDa del Camino"
  lines:
  - "Alto ah\xED, viajero. Pocos pasan por este camino cuando la bruma baja."
  - Dicen que el barro se traga las huellas... y a quien las deja.
  - "Si buscas refugio, la caba\xF1a del norte sigue en pie. La del oeste, no tanto."
  - "Mant\xE9n la linterna cerca. La niebla no es lo peor que vive aqu\xED."
  portrait: {fileID: 8400000, guid: fc14479881877f34b98ca44ddbf99a29, type: 2}
  interactRadius: 2.8
  promptAnchor: {fileID: 1670563120311379166}
